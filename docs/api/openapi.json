{
  "components": {
    "schemas": {
      "CommandCatalog": {
        "additionalProperties": false,
        "properties": {
          "commands": {
            "items": {
              "$ref": "#/components/schemas/CommandInfo"
            },
            "title": "Commands",
            "type": "array"
          }
        },
        "required": [
          "commands"
        ],
        "title": "CommandCatalog",
        "type": "object"
      },
      "CommandInfo": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "params": {
            "items": {
              "type": "string"
            },
            "title": "Params",
            "type": "array"
          },
          "summary": {
            "title": "Summary",
            "type": "string"
          },
          "tier": {
            "$ref": "#/components/schemas/Tier"
          }
        },
        "required": [
          "name",
          "tier",
          "params",
          "summary"
        ],
        "title": "CommandInfo",
        "type": "object"
      },
      "CommandRequest": {
        "additionalProperties": false,
        "properties": {
          "confirmation_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confirmation Id"
          },
          "name": {
            "maxLength": 64,
            "title": "Name",
            "type": "string"
          },
          "params": {
            "additionalProperties": {
              "maxLength": 1000,
              "type": "string"
            },
            "maxProperties": 8,
            "propertyNames": {
              "maxLength": 64
            },
            "title": "Params",
            "type": "object"
          },
          "request_id": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{7,127}$",
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "name"
        ],
        "title": "CommandRequest",
        "type": "object"
      },
      "CommandResponse": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "additionalProperties": true,
            "title": "Detail",
            "type": "object"
          },
          "ok": {
            "title": "Ok",
            "type": "boolean"
          },
          "replayed": {
            "title": "Replayed",
            "type": "boolean"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          }
        },
        "required": [
          "request_id",
          "ok",
          "replayed",
          "detail"
        ],
        "title": "CommandResponse",
        "type": "object"
      },
      "ConfirmationRequest": {
        "additionalProperties": false,
        "description": "高危命令的二次确认申请：命令名与参数必须与随后提交的命令完全一致。",
        "properties": {
          "name": {
            "maxLength": 64,
            "title": "Name",
            "type": "string"
          },
          "params": {
            "additionalProperties": {
              "maxLength": 1000,
              "type": "string"
            },
            "maxProperties": 8,
            "propertyNames": {
              "maxLength": 64
            },
            "title": "Params",
            "type": "object"
          }
        },
        "required": [
          "name"
        ],
        "title": "ConfirmationRequest",
        "type": "object"
      },
      "ConfirmationResponse": {
        "additionalProperties": false,
        "properties": {
          "confirmation_id": {
            "title": "Confirmation Id",
            "type": "string"
          },
          "expires_at": {
            "title": "Expires At",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "confirmation_id",
          "name",
          "expires_at"
        ],
        "title": "ConfirmationResponse",
        "type": "object"
      },
      "ErrorResponse": {
        "additionalProperties": false,
        "properties": {
          "error": {
            "title": "Error",
            "type": "string"
          },
          "retry_same_request_id": {
            "default": false,
            "title": "Retry Same Request Id",
            "type": "boolean"
          }
        },
        "required": [
          "error",
          "retry_same_request_id"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "EventKind": {
        "enum": [
          "RISK_APPROVED",
          "RISK_REJECTED",
          "SUBMIT_SENT",
          "BROKER_ACK",
          "BROKER_REJECTED",
          "SUBMIT_TIMEOUT",
          "PARTIAL_FILL",
          "FULL_FILL",
          "CANCEL_REQUESTED",
          "CANCEL_CONFIRMED",
          "CANCEL_REJECTED",
          "BROKER_CANCELLED",
          "EXPIRED",
          "BROKER_STATUS_OBSERVED"
        ],
        "title": "EventKind",
        "type": "string"
      },
      "ExecutionView": {
        "additionalProperties": false,
        "properties": {
          "commission": {
            "title": "Commission",
            "type": "string"
          },
          "executed_at": {
            "title": "Executed At",
            "type": "string"
          },
          "execution_id": {
            "title": "Execution Id",
            "type": "string"
          },
          "price": {
            "title": "Price",
            "type": "string"
          },
          "quantity": {
            "title": "Quantity",
            "type": "string"
          },
          "side": {
            "$ref": "#/components/schemas/Side"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          }
        },
        "required": [
          "execution_id",
          "symbol",
          "side",
          "quantity",
          "price",
          "commission",
          "executed_at"
        ],
        "title": "ExecutionView",
        "type": "object"
      },
      "HaltView": {
        "additionalProperties": false,
        "properties": {
          "halted": {
            "title": "Halted",
            "type": "boolean"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "set_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Set By"
          },
          "since": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Since"
          }
        },
        "required": [
          "halted",
          "reason",
          "since",
          "set_by"
        ],
        "title": "HaltView",
        "type": "object"
      },
      "HistoryEntry": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/EventKind"
          },
          "occurred_at": {
            "title": "Occurred At",
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/OrderStatus"
          }
        },
        "required": [
          "kind",
          "status",
          "occurred_at"
        ],
        "title": "HistoryEntry",
        "type": "object"
      },
      "Mode": {
        "enum": [
          "RESEARCH",
          "BACKTEST",
          "PAPER",
          "ASSISTED_LIVE",
          "LIMITED_AUTO_LIVE",
          "HALT"
        ],
        "title": "Mode",
        "type": "string"
      },
      "OrderClass": {
        "description": "订单类别在创建时确定，之后不可修改；guardd 与急停按类别撤单（V4.1 6.4）。",
        "enum": [
          "OPEN",
          "REDUCE",
          "PROTECTIVE_STOP"
        ],
        "title": "OrderClass",
        "type": "string"
      },
      "OrderDetail": {
        "additionalProperties": false,
        "properties": {
          "executions": {
            "items": {
              "$ref": "#/components/schemas/ExecutionView"
            },
            "title": "Executions",
            "type": "array"
          },
          "history": {
            "items": {
              "$ref": "#/components/schemas/HistoryEntry"
            },
            "title": "History",
            "type": "array"
          },
          "order": {
            "$ref": "#/components/schemas/OrderView"
          }
        },
        "required": [
          "order",
          "history",
          "executions"
        ],
        "title": "OrderDetail",
        "type": "object"
      },
      "OrderList": {
        "additionalProperties": false,
        "properties": {
          "orders": {
            "items": {
              "$ref": "#/components/schemas/OrderView"
            },
            "title": "Orders",
            "type": "array"
          }
        },
        "required": [
          "orders"
        ],
        "title": "OrderList",
        "type": "object"
      },
      "OrderStatus": {
        "enum": [
          "CREATED",
          "RISK_APPROVED",
          "REJECTED_BY_RISK",
          "SUBMITTING",
          "SUBMITTED",
          "PARTIALLY_FILLED",
          "CANCEL_PENDING",
          "UNKNOWN",
          "FILLED",
          "CANCELLED",
          "REJECTED",
          "EXPIRED"
        ],
        "title": "OrderStatus",
        "type": "string"
      },
      "OrderType": {
        "description": "没有市价单：一般订单只用限价单，止损单只用于保护性止损（R-04 专项豁免）。",
        "enum": [
          "LIMIT",
          "STOP"
        ],
        "title": "OrderType",
        "type": "string"
      },
      "OrderView": {
        "additionalProperties": false,
        "properties": {
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          },
          "intent_id": {
            "title": "Intent Id",
            "type": "string"
          },
          "limit_price": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Limit Price"
          },
          "order_class": {
            "$ref": "#/components/schemas/OrderClass"
          },
          "order_type": {
            "$ref": "#/components/schemas/OrderType"
          },
          "quantity": {
            "title": "Quantity",
            "type": "string"
          },
          "side": {
            "$ref": "#/components/schemas/Side"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/OrderStatus"
              },
              {
                "type": "null"
              }
            ]
          },
          "stop_price": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Stop Price"
          },
          "strategy_id": {
            "title": "Strategy Id",
            "type": "string"
          },
          "strategy_version": {
            "title": "Strategy Version",
            "type": "string"
          },
          "symbol": {
            "title": "Symbol",
            "type": "string"
          },
          "time_in_force": {
            "$ref": "#/components/schemas/TimeInForce"
          },
          "updated_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Updated At"
          }
        },
        "required": [
          "intent_id",
          "created_at",
          "strategy_id",
          "strategy_version",
          "symbol",
          "side",
          "quantity",
          "order_type",
          "limit_price",
          "stop_price",
          "order_class",
          "time_in_force",
          "expires_at",
          "status",
          "updated_at"
        ],
        "title": "OrderView",
        "type": "object"
      },
      "RevokeRequest": {
        "additionalProperties": false,
        "properties": {
          "reason": {
            "maxLength": 500,
            "minLength": 1,
            "pattern": "\\S",
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "reason"
        ],
        "title": "RevokeRequest",
        "type": "object"
      },
      "RevokeResponse": {
        "additionalProperties": false,
        "properties": {
          "revoked": {
            "title": "Revoked",
            "type": "boolean"
          },
          "token_id": {
            "title": "Token Id",
            "type": "string"
          }
        },
        "required": [
          "token_id",
          "revoked"
        ],
        "title": "RevokeResponse",
        "type": "object"
      },
      "Side": {
        "enum": [
          "BUY",
          "SELL"
        ],
        "title": "Side",
        "type": "string"
      },
      "StatusView": {
        "additionalProperties": false,
        "properties": {
          "changed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Changed At"
          },
          "changed_by": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Changed By"
          },
          "halt": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/HaltView"
              },
              {
                "type": "null"
              }
            ]
          },
          "mode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Mode"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "mode",
          "halt",
          "changed_at",
          "changed_by"
        ],
        "title": "StatusView",
        "type": "object"
      },
      "Tier": {
        "enum": [
          "control",
          "high"
        ],
        "title": "Tier",
        "type": "string"
      },
      "TimeInForce": {
        "enum": [
          "DAY",
          "GTD",
          "GTC"
        ],
        "title": "TimeInForce",
        "type": "string"
      },
      "WhoAmI": {
        "additionalProperties": false,
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "role": {
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "name",
          "role"
        ],
        "title": "WhoAmI",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "QTS apid",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/commands": {
      "post": {
        "operationId": "command_v1_commands_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommandRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too Many Requests"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "504": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Gateway Timeout"
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "summary": "Command"
      }
    },
